{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "missionforge",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MissionAgent",
        "class_name": "MissionAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MissionAgent"]
    }
  ],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS"
  }
}